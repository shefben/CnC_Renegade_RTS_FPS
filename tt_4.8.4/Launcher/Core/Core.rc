IDD_SELFUPDATE DIALOGEX 0, 0, 202, 58
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Updating..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "An update is being downloaded. Please wait...",IDC_STATUS_TEXT,6,6,174,8
    CONTROL         "",IDC_DOWNLOADPROGRESS,"msctls_progress32",PBS_SMOOTH,6,24,192,14,WS_EX_STATICEDGE
    PUSHBUTTON      "Cancel",IDC_CANCEL_DONE,120,42,78,14,0,WS_EX_STATICEDGE
END

IDD_GAMEUPDATE DIALOGEX 0, 0, 250, 58
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Updating..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Downloading update %u of %u...",IDC_STATUS_TEXT,6,6,138,8
    CONTROL         "",IDC_DOWNLOADPROGRESS,"msctls_progress32",PBS_SMOOTH,6,24,240,14,WS_EX_STATICEDGE
    PUSHBUTTON      "Cancel",IDC_CANCEL_DONE,168,42,78,14,0,WS_EX_STATICEDGE
    RTEXT           "0.0 KB/0.0 KB",IDC_SIZE_STATE,144,6,103,8
END


