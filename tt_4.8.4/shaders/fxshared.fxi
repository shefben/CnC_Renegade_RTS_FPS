#ifdef __cplusplus // Mappings to HLSL types for C++
typedef Vector2				float2; 
typedef Vector3				float3; 
typedef Vector4				float4;
typedef Matrix4				float4x4;
#endif

struct SoALightDataStruct
{
	float4 light_x;
	float4 light_y;
	float4 light_z;
	float3 light_color[4];
};

#define FOGMODE_NONE 0
#define FOGMODE_EXP 1
#define FOGMODE_EXP2 1 
#define FOGMODE_LINEAR 3

struct W3DFogStruct
{
	int Mode;
	float Start;
	float End;
	float Density;
	float3 Color;
};

struct W3DFogStruct2
{
	int Mode;
	float OneOverRange;
	float FogEndOverRange;
	float Density;
	float3 Color;
};

struct TextureInfoStruct
{
	float	Width;
	float	Height;
	// PixelWidth/PixelHeight = width/height of one pixel in texture coordinate units
	float	PixelWidth;
	float	PixelHeight;
};

struct SamplerSettings
{
	int AddressU;
	int AddressV;
	int MagFilter;
	int MinFilter;
	int MipFilter;
	int MaxAnisotropy;
};

#ifndef __cplusplus
SamplerSettings sampler0_settings
<
	string SasBindAddress="W3D.Sampler0Settings";
	string UIWidget = "none";
>;
#endif