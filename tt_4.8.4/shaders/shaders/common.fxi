#define DECLARE_SHARED_TRANSFORM(transformName, semantic) shared float4x4 transformName: semantic;
		
DECLARE_SHARED_TRANSFORM(matW, 		World);
DECLARE_SHARED_TRANSFORM(matWT, 	WorldTranspose);
DECLARE_SHARED_TRANSFORM(matWI, 	WorldInverse);
DECLARE_SHARED_TRANSFORM(matWIT, 	WorldInverseTranspose);
DECLARE_SHARED_TRANSFORM(matV,		View);
DECLARE_SHARED_TRANSFORM(matVT,		ViewTranspose);
DECLARE_SHARED_TRANSFORM(matVI,		ViewInverse);
DECLARE_SHARED_TRANSFORM(matVIT,	ViewInverseTranspose);
DECLARE_SHARED_TRANSFORM(matP,		Projection);
DECLARE_SHARED_TRANSFORM(matPT,		ProjectionTranspose);
DECLARE_SHARED_TRANSFORM(matPI,		ProjectionInverse);
DECLARE_SHARED_TRANSFORM(matPIT,	ProjectionInverseTranspose);
DECLARE_SHARED_TRANSFORM(matWV,		WorldView);
DECLARE_SHARED_TRANSFORM(matWVT,	WorldViewTranspose);
DECLARE_SHARED_TRANSFORM(matWVI,	WorldViewInverse);
DECLARE_SHARED_TRANSFORM(matWVIT,	WorldViewInverseTranspose);
DECLARE_SHARED_TRANSFORM(matVP,		ViewProjection);
DECLARE_SHARED_TRANSFORM(matVPT,	ViewProjectionTranspose);
DECLARE_SHARED_TRANSFORM(matVPI,	ViewProjectionInverse);
DECLARE_SHARED_TRANSFORM(matVPIT,	ViewProjectionInverseTranspose);
DECLARE_SHARED_TRANSFORM(matWVP,	WorldViewProjection);
DECLARE_SHARED_TRANSFORM(matWVPT,	WorldViewProjectionTranspose);
DECLARE_SHARED_TRANSFORM(matWVPI,	WorldViewProjectionInverse);
DECLARE_SHARED_TRANSFORM(matWVPIT,	WorldViewProjectionInverseTranspose);
DECLARE_SHARED_TRANSFORM(matT0,		TexCoord0);
DECLARE_SHARED_TRANSFORM(matT1,		TexCoord1);

float2 CalculateTextureCoordinates(float2 texcoord, float4x4 mat)
{
	float4 tex_in = float4(texcoord.x, texcoord.y, 0.0f, 1.0f);
	return mul(tex_in, mat).xy;
};

float3 CalculateTextureCoordinates(float3 texcoord, float4x4 mat)
{
	float4 tex_in = float4(texcoord.x, texcoord.y, texcoord.z, 1.0f);
	return mul(tex_in, mat).xyz;
};