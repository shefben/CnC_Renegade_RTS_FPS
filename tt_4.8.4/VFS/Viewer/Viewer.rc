/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINMENU MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",                ID_NEW
        MENUITEM "&Open\tCtrl+O",               ID_OPEN
        MENUITEM "&Close",                      ID_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Exit\tAlt+F4",                ID_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Extract\tCtrl+E",            ID_EXTRACT
        MENUITEM "Extract &all\tCtrl+A",        ID_EXTRACTALL
        MENUITEM SEPARATOR
        MENUITEM "Delete",                      ID_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Import directory\tCtrl+D",    ID_IMPORT_DIR
        MENUITEM "Import file\tCtrl+I",         ID_IMPORT_FILE
        MENUITEM "Create directory\tIns",       ID_CREATE_DIR
        MENUITEM "Rename\tF2",                  ID_RENAME
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_HOTKEYS ACCELERATORS 
BEGIN
    VK_INSERT,      ID_CREATE_DIR,          VIRTKEY, NOINVERT
    VK_F4,          ID_EXIT,                VIRTKEY, ALT, NOINVERT
    "E",            ID_EXTRACT,             VIRTKEY, CONTROL, NOINVERT
    "A",            ID_EXTRACTALL,          VIRTKEY, CONTROL, NOINVERT
    VK_F3,          ID_FINDNEXT,            VIRTKEY, NOINVERT
    "D",            ID_IMPORT_DIR,          VIRTKEY, CONTROL, NOINVERT
    "I",            ID_IMPORT_FILE,         VIRTKEY, CONTROL, NOINVERT
    "N",            ID_NEW,                 VIRTKEY, ALT, NOINVERT
    "O",            ID_OPEN,                VIRTKEY, CONTROL, NOINVERT
    VK_F2,          ID_RENAME,              VIRTKEY, NOINVERT
END

